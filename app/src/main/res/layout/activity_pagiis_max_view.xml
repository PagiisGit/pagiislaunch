<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".PagiisMaxView">


    <RelativeLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">




        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:padding="7dp"
            android:layout_height="match_parent"
            android:background="#55000000"
            android:backgroundTint="@color/Orrnge"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center">




            <ProgressBar
                android:id="@+id/PagiisMaxProgressBar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center" />


            <ImageView
                android:id="@+id/pagiis_max_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="#fff"
                android:clickable="true"
                android:contextClickable="true"
                android:foreground="?android:selectableItemBackground"
                android:src="@drawable/gallery"
                tools:ignore="SpeakableTextPresentCheck" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/videoPlayer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_alignParentRight="true"
                android:layout_alignParentStart="true"
                android:layout_gravity="center_horizontal"
                android:layout_marginStart="0dp"
                android:layout_alignParentLeft="true"
                android:layout_alignParentTop="true"
                android:layout_marginEnd="0dp"
                android:layout_marginTop="0dp"
                android:visibility="gone"
                app:resize_mode="fit"
                app:use_controller="true"
                android:clickable="true"
                android:contextClickable="true"
                android:focusable="true"
                android:foregroundGravity="center_horizontal"
                android:scaleType="centerCrop"
                android:src="@drawable/for_gallery_pic"
                tools:ignore="SpeakableTextPresentCheck">

            </androidx.media3.ui.PlayerView>


            <TextView
                android:id="@+id/linkTextView"
                android:layout_width="270dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="700dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="#fff"
                android:backgroundTint="#55000000"
                android:clickable="true"
                android:contextClickable="true"
                android:ellipsize="end"
                android:fontFamily="@font/robobold"
                android:foreground="?android:selectableItemBackground"
                android:lines="3"
                android:text=""
                android:textColor="#fff"
                android:textSize="12sp"
                tools:ignore="SpeakableTextPresentCheck" />


            <ImageView
                android:id="@+id/downloadLink"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:layout_marginRight="10dp"
                android:clickable="true"
                android:layout_marginStart="290dp"
                android:layout_marginTop="700dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/download"
                android:layout_marginBottom="10dp"
                android:defaultFocusHighlightEnabled="true"
                android:fontFamily="@font/yogamedium"
                android:foreground="?android:selectableItemBackground"
                android:textColor="#fff"
                android:textSize="20sp"
                tools:ignore="SpeakableTextPresentCheck">

            </ImageView>



        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/ripplePost"
            android:layout_width="100dp"
            android:layout_alignParentEnd="true"
            android:layout_marginRight="10dp"
            android:layout_marginTop="10dp"
            android:layout_height="50dp"
            android:background="@drawable/red_background_button"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="true"
            android:fontFamily="@font/yogamedium"
            android:foreground="?android:selectableItemBackground"

            android:text="order"
            android:textColor="#fff"
            android:textSize="20sp"
            tools:ignore="SpeakableTextPresentCheck" >


        </Button>







    </RelativeLayout>



    <ProgressBar

        android:id="@+id/progress_circle_webview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_gravity="center" />






</androidx.cardview.widget.CardView>