<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".PagiisMaxView">





    <RelativeLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">




        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:padding="7dp"
            android:layout_height="match_parent"
            android:background="#55000000"
            android:backgroundTint="@color/Orrnge"
            android:layout_alignParentTop="true"
            android:layout_centerHorizontal="true"
            android:layout_gravity="center">




            <ProgressBar
                android:id="@+id/PagiisMaxProgressBar"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center" />


            <ImageView
                android:id="@+id/pagiis_max_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="#fff"
                android:clickable="true"
                android:contextClickable="true"
                android:foreground="?android:selectableItemBackground"
                android:src="@drawable/gallery"
                tools:ignore="SpeakableTextPresentCheck" />

            <TextView
                android:id="@+id/linkTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="700dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="#fff"
                android:backgroundTint="#55000000"
                android:clickable="true"
                android:contextClickable="true"
                android:ellipsize="end"
                android:fontFamily="@font/robobold"
                android:foreground="?android:selectableItemBackground"
                android:lines="3"
                android:text=""
                android:textColor="@color/colorPrimaryText"
                android:textSize="25sp"
                tools:ignore="SpeakableTextPresentCheck" />


        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/ripplePost"
            android:layout_width="100dp"
            android:layout_alignParentEnd="true"
            android:layout_marginRight="10dp"
            android:layout_marginTop="10dp"
            android:layout_height="50dp"
            android:background="@drawable/red_background_button"
            android:clickable="true"
            android:defaultFocusHighlightEnabled="true"
            android:fontFamily="@font/yogamedium"
            android:foreground="?android:selectableItemBackground"

            android:text="order"
            android:textColor="#fff"
            android:textSize="20sp"
            tools:ignore="SpeakableTextPresentCheck" />







    </RelativeLayout>



    <ProgressBar

        android:id="@+id/progress_circle_webview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_gravity="center" />






</androidx.cardview.widget.CardView>